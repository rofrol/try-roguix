HOSTNAME = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
TIMEZONE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$")


class Failure(Exception):
    pass


def host_settings(path=HOST_SETTINGS):
    """The launcher's name=value settings, or {} without a launcher."""
    try:
        with open(path, encoding="utf-8") as stream:
            text = stream.read()
    except OSError:
        return {}
    return dict(token.split("=", 1) for token in text.split() if "=" in token)


def suggested_layout(settings):
    layout = settings.get("tryomarchy.keyboard_layout", "us")
    variant = settings.get("tryomarchy.keyboard_variant", "")
    for entry in LAYOUTS:
        if entry[1:3] == (layout, variant):
            return entry
    return LAYOUTS[0]


def suggested_timezone(settings):
    encoded = settings.get("tryomarchy.timezone", "")
    try:
        zone = base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)).decode()
    except (ValueError, UnicodeDecodeError):
        return "Etc/UTC"
    return zone if valid_timezone(zone) else "Etc/UTC"


def valid_timezone(zone, zoneinfo=None):
    return bool(TIMEZONE.match(zone)) and ".." not in zone \
        and os.path.isfile(os.path.join(zoneinfo or ZONEINFO, zone))


def scheme_string(text):
    """A Scheme string literal for TEXT, already restricted to safe characters."""
    if not re.fullmatch(r"[A-Za-z0-9_+./-]*", text):
        raise Failure(f"refusing to write {text!r} into {MACHINE_SETTINGS}")
    return '"' + text + '"'


def machine_settings(host_name, timezone, layout):
    """The machine settings file's text: data that /etc/config.scm and the
    roguix-machine-settings service read, never load."""
    _, xkb_layout, variant, keymap = layout
    fields = (("host-name", host_name), ("timezone", timezone),
              ("keyboard-layout", xkb_layout), ("keyboard-variant", variant),
              ("console-keymap", keymap))
    return (";; Written by roguix-setup; read by /etc/config.scm and at boot.\n("
            + "\n ".join(f"({key} . {scheme_string(value)})" for key, value in fields)
            + ")\n")


def _interrupt(number, frame):
    raise KeyboardInterrupt


class Terminal:
    """Questions on one terminal, read in raw mode by this one process.

    INPUT and OUTPUT are file descriptors; EVENTS is a file the step
    announcements go to, or None. A non-terminal INPUT (a pipe, in tests)
    is read as it is.
    """

    TITLE = "Roguix: first start"

    def __init__(self, input_fd=0, output_fd=1, events=None):
        self.input = input_fd
        self.output = output_fd
        self.events = events
        self.notes = []
        self.saved = None

    def __enter__(self):
        # A termination signal unwinds through __exit__, which restores the
        # terminal; otherwise SIGTERM or SIGHUP left tty1 in raw mode.
        for number in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, _interrupt)
        if os.isatty(self.input):
            self.saved = termios.tcgetattr(self.input)
            # A run killed before this fix may have left the terminal raw;
            # restore an ordinary line-editing terminal, not that.
            self.saved[0] |= termios.ICRNL | termios.IXON
            self.saved[3] |= termios.ICANON | termios.ECHO | termios.ISIG
            mode = termios.tcgetattr(self.input)
            mode[0] &= ~(termios.ICRNL | termios.IXON)
            mode[3] &= ~(termios.ICANON | termios.ECHO | termios.ISIG)
            mode[6][termios.VMIN] = 1
            mode[6][termios.VTIME] = 0
            # TCSANOW, never TCSAFLUSH: that would drop keys typed ahead.
            termios.tcsetattr(self.input, termios.TCSANOW, mode)
        return self

    def __exit__(self, *_):
        if self.saved is not None:
            termios.tcsetattr(self.input, termios.TCSANOW, self.saved)
        self.write("\x1b[?25h\r\n")

    def write(self, text):
        os.write(self.output, text.encode())

    def event(self, text):
        """Announce TEXT on the event channel; best effort, never blocking."""
        if self.events is None:
            return
        try:
            self.events.write(f"roguix-setup: {text}\n")
            self.events.flush()
        except OSError:
            self.events = None

    def note(self, text):
        """Show TEXT above the following questions (validation messages)."""
        self.notes = (self.notes + [text])[-4:]

    def key(self):
        """The next key: a character, or "enter", "backspace", "up",
        "down", "left", "right", "clear" or "interrupt"."""
        byte = os.read(self.input, 1)
        if not byte:
            raise KeyboardInterrupt
        if byte in (b"\r", b"\n"):
            return "enter"
        if byte in (b"\x7f", b"\x08"):
            return "backspace"
        if byte == b"\x15":
            return "clear"
        if byte in (b"\x03", b"\x04"):
            return "interrupt"
        if byte == b"\x1b":
            sequence = b""
            while select.select([self.input], [], [], 0.05)[0] and len(sequence) < 8:
                sequence += os.read(self.input, 1)
                if sequence[-1:].isalpha() or sequence[-1:] == b"~":
                    break
            return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down",
                    b"[C": "right", b"OC": "right", b"[D": "left",
                    b"OD": "left"}.get(sequence, "ignored")
        if byte[0] >= 0x80:
            # Gather a UTF-8 character.
            needed = 1 if byte[0] >= 0xC0 else 0
            needed += 1 if byte[0] >= 0xE0 else 0
            needed += 1 if byte[0] >= 0xF0 else 0
            for _ in range(needed):
                byte += os.read(self.input, 1)
            return byte.decode(errors="replace")
        return byte.decode() if byte.isascii() and byte >= b" " else "ignored"

    def draw(self, lines, cursor=None):
        """Show LINES below the title and notes. CURSOR, a (line, column)
        pair within LINES counted from 0, is where typing appears; without
        it the cursor is hidden rather than left after the last line."""
        top = [self.TITLE, ""] + self.notes + ([""] if self.notes else [])
        place = "\x1b[?25l"
        if cursor is not None:
            line, column = cursor
            place = f"\x1b[{len(top) + line + 1};{column + 1}H\x1b[?25h"
        self.write("\x1b[H\x1b[2J" + "\r\n".join(top + lines) + place)

    def ask(self, step, header, value="", password=False):
        """A line of text; Enter accepts it."""
        self.event(f"ready {step}")
        while True:
            shown = "*" * len(value) if password else value
            prompt = f"> {shown}"
            self.draw([header, prompt, "", "enter submit"], (1, len(prompt)))
            key = self.key()
            if key == "interrupt":
                raise KeyboardInterrupt
            if key == "enter":
                self.event(f"accepted {step}")
                return value
            if key == "backspace":
                value = value[:-1]
            elif key == "clear":
                value = ""
            elif len(key) == 1:
                value += key

    def choose(self, step, header, items, selected=None, height=15):
        """One of ITEMS; typing narrows the list, arrows move, Enter picks."""
        self.event(f"ready {step}")
        query = ""
        current = items.index(selected) if selected in items else 0
        chosen = items[current]
        while True:
            shown = [item for item in items if query.lower() in item.lower()]
            if chosen not in shown:
                chosen = shown[0] if shown else None
            index = shown.index(chosen) if chosen is not None else 0
            top = max(0, min(index - height // 2, len(shown) - height))
            rows = [("> " if item == chosen else "  ") + item
                    for item in shown[top:top + height]]
            self.draw([header, f"/ {query}", ""] + (rows or ["  (no match)"])
                      + ["", "type to search, up/down to move, enter to pick"],
                      (1, len(query) + 2))
            key = self.key()
            if key == "interrupt":
                raise KeyboardInterrupt
            if key == "enter" and chosen is not None:
                self.event(f"accepted {step}")
                return chosen
            if key == "up" and shown:
                chosen = shown[max(0, index - 1)]
            elif key == "down" and shown:
                chosen = shown[min(len(shown) - 1, index + 1)]
            elif key == "backspace":
                query = query[:-1]
            elif key == "clear":
                query = ""
            elif len(key) == 1:
                query += key

    def confirm(self, step, lines, question):
        """Yes or no, Yes by default; y, n, arrows and Enter."""
        self.event(f"ready {step}")
        answer = True
        while True:
            choice = "[ Yes ]   No  " if answer else "  Yes   [ No ]"
            self.draw(lines + ["", question, choice, "", "y/n, left/right, enter"])
            key = self.key()
            if key == "interrupt":
                raise KeyboardInterrupt
            if key in ("y", "Y"):
                answer = True
            elif key in ("n", "N"):
                answer = False
            elif key in ("left", "right"):
                answer = not answer
            elif key == "enter":
                self.event(f"accepted {step} {'yes' if answer else 'no'}")
                return answer


def ask_layout(terminal, suggestion):
    labels = [entry[0] for entry in LAYOUTS]
    chosen = terminal.choose("keyboard", "Keyboard layout", labels, suggestion[0])
    return next(entry for entry in LAYOUTS if entry[0] == chosen)


def ask_password(terminal):
    while True:
        first = terminal.ask(
            "password", f"Password of the account '{ACCOUNT}' (sudo asks for it)",
            password=True)
        problem = None
        if not first:
            problem = "The password must not be empty."
        elif ":" in first:
            problem = "The password must not contain ':'."
        elif terminal.ask("password-repeat", "Repeat the password",
                          password=True) != first:
            problem = "The passwords differ."
        if problem is None:
            return first
        terminal.note(problem)
        terminal.event(f"rejected password {problem}")


def ask_host_name(terminal):
    while True:
        name = terminal.ask("host-name", "Host name", value="roguix")
        if HOSTNAME.match(name):
            return name
        problem = "Use lowercase letters, digits and inner hyphens (up to 63)."
        terminal.note(problem)
        terminal.event(f"rejected host-name {problem}")


def zones(zoneinfo=None):
    """Region/City zone names, plus UTC."""
    zoneinfo = zoneinfo or ZONEINFO
    found = ["UTC"]
    for directory, _, files in os.walk(zoneinfo):
        for name in files:
            zone = os.path.relpath(os.path.join(directory, name), zoneinfo)
            if "/" in zone and zone[0].isupper() and TIMEZONE.match(zone) \
                    and not zone.startswith(("Etc/", "SystemV/", "posix/", "right/")):
                found.append(zone)
    return sorted(set(found))


def ask_timezone(terminal, suggestion):
    chosen = terminal.choose("time-zone", "Time zone", zones(), suggestion)
    return chosen if valid_timezone(chosen) else suggestion


def run(*command, **kwargs):
    return subprocess.run(command, **kwargs).returncode == 0


def apply_layout(entry):
    _, layout, variant, keymap = entry
    run("loadkeys", keymap, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Omarchy's Hyprland input reads XKBLAYOUT and XKBVARIANT from here; the
    # next reconfigure installs the same file from /etc/config.scm.
    replace_file("/etc/vconsole.conf",
                 f"KEYMAP={keymap}\nXKBLAYOUT={layout}\nXKBVARIANT={variant}\n")


def replace_file(path, text):
    staging = path + ".roguix-setup"
    with open(staging, "w", encoding="utf-8") as stream:
        stream.write(text)
    os.chmod(staging, 0o644)
    os.replace(staging, path)


def set_password(password):
    process = subprocess.run(["chpasswd", "--crypt-method", "SHA512"],
                             input=f"{ACCOUNT}:{password}\n", text=True)
    if process.returncode != 0:
        raise Failure("could not set the password")


def set_git_identity(name, email):
    account = pwd.getpwnam(ACCOUNT)
    path = os.path.join(account.pw_dir, ".gitconfig")
    for key, value in (("user.name", name), ("user.email", email)):
        if value:
            run("git", "config", "--file", path, key, value)
    if os.path.exists(path):
        os.chown(path, account.pw_uid, account.pw_gid)


def renamed_hosts(text, previous, host_name):
    """/etc/hosts TEXT with the host name PREVIOUS, as a whole word, renamed."""
    return re.sub(rf"(?<![\w.-]){re.escape(previous)}(?![\w.-])", host_name, text)


def apply_system(host_name, timezone, hosts="/etc/hosts"):
    previous = socket.gethostname()
    run("hostname", host_name)
    # Keep /etc/hosts resolving the name, or sudo waits on DNS.
    with open(hosts, encoding="utf-8") as stream:
        text = stream.read()
    replace_file(hosts, renamed_hosts(text, previous, host_name))
    zone = os.path.join(ZONEINFO, timezone)
    staging = "/etc/localtime.roguix-setup"
    if os.path.lexists(staging):
        os.remove(staging)
    os.symlink(zone, staging)
    os.replace(staging, "/etc/localtime")


def ask_all(terminal, settings):
    """Every answer, in Omarchy's order; returns them once confirmed."""
    layout = ask_layout(terminal, suggested_layout(settings))
    apply_layout(layout)
    password = ask_password(terminal)
    while True:
        name = terminal.ask("git-name", "Your name for Git commits (optional)")
        email = terminal.ask("git-email", "Your email for Git commits (optional)")
        host_name = ask_host_name(terminal)
        timezone = ask_timezone(terminal, suggested_timezone(settings))
        summary = [f"Keyboard:  {layout[0]}", f"Host name: {host_name}",
                   f"Time zone: {timezone}",
                   f"Git:       {name or '-'} <{email or '-'}>"]
        if terminal.confirm("confirm", summary, "Save these settings?"):
            return layout, password, name, email, host_name, timezone


def open_events():
    """The serial console, opened so that a full or absent reader never
    blocks the setup."""
    try:
        return os.fdopen(os.open(EVENTS, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK),
                         "w", encoding="utf-8")
    except OSError:
        return None


def main():
    settings = host_settings()
    with Terminal(events=open_events()) as terminal:
        layout, password, name, email, host_name, timezone = ask_all(terminal, settings)
        set_git_identity(name, email)
        os.makedirs(os.path.dirname(MACHINE_SETTINGS), mode=0o755, exist_ok=True)
        replace_file(MACHINE_SETTINGS, machine_settings(host_name, timezone, layout))
        apply_system(host_name, timezone)
        # The password last: until it is set, first boot runs this setup again.
        set_password(password)
        terminal.event("finished")
        terminal.draw([f"Saved in {MACHINE_SETTINGS}. Starting the desktop."])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except Failure as error:
        print(f"roguix-setup: {error}", file=sys.stderr)
        sys.exit(1)
