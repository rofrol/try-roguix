#!/usr/bin/env python3
"""roguix-setup: Roguix's first-start setup on tty1, run as root.

It asks in Omarchy's order (install/provisioning/setup-form.sh): keyboard
layout, the password of the account, an optional Git name and email, the host
name and the time zone. The Mac app suggests the keyboard layout and time zone
through the launcher's settings (/run/roguix/host-settings).

System values go into the setup block of /etc/config.scm, between its
markers, and take effect at once for this boot; the Git identity goes into
the account's ~/.gitconfig. A reconfigure started in the background makes
the system values part of the system generation, so they survive a restart;
a notification tells the account when it has finished.
"""

import base64
import os
import pwd
import re
import subprocess
import sys

ACCOUNT = "guest"
CONFIG = "/etc/config.scm"
HOST_SETTINGS = "/run/roguix/host-settings"
BEGIN = ";; BEGIN roguix setup"
END = ";; END roguix setup"


def system_zoneinfo():
    """The zoneinfo directory of the running system's tzdata.

    Guix keeps tzdata out of the system profile: TZDIR names it in login
    shells, and /run/current-system/etc/localtime links into it otherwise.
    """
    tzdir = os.environ.get("TZDIR", "")
    if os.path.isdir(tzdir):
        return tzdir
    target = os.path.realpath("/run/current-system/etc/localtime")
    marker = "/share/zoneinfo/"
    if marker in target:
        return target[:target.index(marker) + len(marker) - 1]
    return "/usr/share/zoneinfo"


ZONEINFO = system_zoneinfo()
RECONFIGURE = "/run/current-system/profile/bin/roguix-reconfigure"
RECONFIGURE_LOG = "/var/log/roguix-setup-reconfigure.log"
GUM = "gum"

# (label, XKB layout, XKB variant, console keymap). XKB drives Guix's
# keyboard-layout and Hyprland (through /etc/vconsole.conf); the console
# keymap is only for loadkeys during this boot.
LAYOUTS = (
    ("English (US)", "us", "", "us"),
    ("English (US, international)", "us", "intl", "us-acentos"),
    ("English (UK)", "gb", "", "uk"),
    ("English (US, Dvorak)", "us", "dvorak", "dvorak"),
    ("English (US, Colemak)", "us", "colemak", "colemak"),
    ("Belgian", "be", "", "be-latin1"),
    ("Brazilian", "br", "", "br-abnt2"),
    ("Croatian", "hr", "", "croat"),
    ("Czech", "cz", "", "cz"),
    ("Danish", "dk", "", "dk-latin1"),
    ("Dutch", "nl", "", "nl"),
    ("Estonian", "ee", "", "et"),
    ("Finnish", "fi", "", "fi"),
    ("French", "fr", "", "fr"),
    ("French (Canada)", "ca", "", "cf"),
    ("French (Switzerland)", "ch", "fr", "fr_CH"),
    ("German", "de", "", "de"),
    ("German (Switzerland)", "ch", "", "de_CH-latin1"),
    ("Greek", "gr", "", "gr"),
    ("Hungarian", "hu", "", "hu"),
    ("Icelandic", "is", "", "is-latin1"),
    ("Irish", "ie", "", "ie"),
    ("Italian", "it", "", "it"),
    ("Japanese", "jp", "", "jp106"),
    ("Latvian", "lv", "", "lv"),
    ("Lithuanian", "lt", "", "lt"),
    ("Norwegian", "no", "", "no-latin1"),
    ("Polish", "pl", "", "pl"),
    ("Portuguese", "pt", "", "pt-latin1"),
    ("Romanian", "ro", "", "ro"),
    ("Russian", "ru", "", "ru"),
    ("Serbian (Latin)", "rs", "latin", "sr-latin"),
    ("Slovak", "sk", "", "sk-qwertz"),
    ("Slovenian", "si", "", "slovene"),
    ("Spanish", "es", "", "es"),
    ("Spanish (Latin American)", "latam", "", "la-latin1"),
    ("Swedish", "se", "", "sv-latin1"),
    ("Turkish", "tr", "", "trq"),
    ("Ukrainian", "ua", "", "ua"),
)

HOSTNAME = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
TIMEZONE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$")


class Failure(Exception):
    pass


def host_settings(path=HOST_SETTINGS):
    """The launcher's name=value settings, or {} without a launcher."""
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return {}
    return dict(token.split("=", 1) for token in text.split() if "=" in token)


def suggested_layout(settings):
    layout = settings.get("tryomarchy.keyboard_layout", "us")
    variant = settings.get("tryomarchy.keyboard_variant", "")
    for entry in LAYOUTS:
        if entry[1:3] == (layout, variant):
            return entry
    return LAYOUTS[0]


def suggested_timezone(settings):
    encoded = settings.get("tryomarchy.timezone", "")
    try:
        zone = base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)).decode()
    except (ValueError, UnicodeDecodeError):
        return "Etc/UTC"
    return zone if valid_timezone(zone) else "Etc/UTC"


def valid_timezone(zone, zoneinfo=None):
    return bool(TIMEZONE.match(zone)) and ".." not in zone \
        and os.path.isfile(os.path.join(zoneinfo or ZONEINFO, zone))


def scheme_string(text):
    """A Scheme string literal for TEXT, already restricted to safe characters."""
    if not re.fullmatch(r"[A-Za-z0-9_+./-]*", text):
        raise Failure(f"refusing to write {text!r} into {CONFIG}")
    return '"' + text + '"'


def setup_block(host_name, timezone, layout, variant):
    lines = [BEGIN,
             f" #:host-name {scheme_string(host_name)}",
             f" #:timezone {scheme_string(timezone)}",
             f" #:keyboard-layout {scheme_string(layout)}"]
    if variant:
        lines.append(f" #:keyboard-variant {scheme_string(variant)}")
    lines.append(" " + END)
    return "\n".join(lines)


def with_setup(text, block):
    """TEXT with its setup block replaced; the markers must be there once."""
    if text.count(BEGIN) != 1 or text.count(END) != 1:
        raise Failure(f"{CONFIG} has no single setup block; edit it by hand")
    start = text.index(BEGIN)
    end = text.index(END) + len(END)
    return text[:start] + block.lstrip() + text[end:]


def gum(*arguments, input_text=None):
    result = subprocess.run([GUM, *arguments], input=input_text, text=True,
                            stdout=subprocess.PIPE)
    if result.returncode != 0:
        raise KeyboardInterrupt
    return result.stdout.strip()


def ask_layout(suggestion):
    labels = [entry[0] for entry in LAYOUTS]
    chosen = gum("choose", "--header", "Keyboard layout", "--height", "15",
                 "--selected", suggestion[0], *labels)
    return next(entry for entry in LAYOUTS if entry[0] == chosen)


def ask_password():
    while True:
        first = gum("input", "--password", "--header",
                    f"Password of the account '{ACCOUNT}' (sudo asks for it)")
        if not first:
            print("The password must not be empty.")
            continue
        if ":" in first:
            print("The password must not contain ':'.")
            continue
        if gum("input", "--password", "--header", "Repeat the password") != first:
            print("The passwords differ.")
            continue
        return first


def ask_host_name():
    while True:
        name = gum("input", "--header", "Host name", "--value", "roguix")
        if HOSTNAME.match(name):
            return name
        print("Use lowercase letters, digits and inner hyphens (up to 63).")


def zones(zoneinfo=None):
    """Region/City zone names, plus UTC."""
    zoneinfo = zoneinfo or ZONEINFO
    found = ["UTC"]
    for directory, _, files in os.walk(zoneinfo):
        for name in files:
            zone = os.path.relpath(os.path.join(directory, name), zoneinfo)
            if "/" in zone and zone[0].isupper() and TIMEZONE.match(zone) \
                    and not zone.startswith(("Etc/", "SystemV/", "posix/", "right/")):
                found.append(zone)
    return sorted(set(found))


def ask_timezone(suggestion):
    chosen = gum("filter", "--header", "Time zone", "--value", suggestion,
                 "--height", "15", input_text="\n".join(zones()))
    return chosen if valid_timezone(chosen) else suggestion


def run(*command, **kwargs):
    return subprocess.run(command, **kwargs).returncode == 0


def apply_layout(entry):
    _, layout, variant, keymap = entry
    run("loadkeys", keymap, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Omarchy's Hyprland input reads XKBLAYOUT and XKBVARIANT from here; the
    # next reconfigure installs the same file from /etc/config.scm.
    replace_file("/etc/vconsole.conf",
                 f"KEYMAP={keymap}\nXKBLAYOUT={layout}\nXKBVARIANT={variant}\n")


def replace_file(path, text):
    staging = path + ".roguix-setup"
    with open(staging, "w", encoding="utf-8") as stream:
        stream.write(text)
    os.chmod(staging, 0o644)
    os.replace(staging, path)


def set_password(password):
    process = subprocess.run(["chpasswd", "--crypt-method", "SHA512"],
                             input=f"{ACCOUNT}:{password}\n", text=True)
    if process.returncode != 0:
        raise Failure("could not set the password")


def set_git_identity(name, email):
    account = pwd.getpwnam(ACCOUNT)
    path = os.path.join(account.pw_dir, ".gitconfig")
    for key, value in (("user.name", name), ("user.email", email)):
        if value:
            run("git", "config", "--file", path, key, value)
    if os.path.exists(path):
        os.chown(path, account.pw_uid, account.pw_gid)


def apply_system(host_name, timezone):
    run("hostname", host_name)
    zone = os.path.join(ZONEINFO, timezone)
    staging = "/etc/localtime.roguix-setup"
    if os.path.lexists(staging):
        os.remove(staging)
    os.symlink(zone, staging)
    os.replace(staging, "/etc/localtime")


def session_bus(uid, proc="/proc"):
    """The D-Bus session address of UID's desktop, or None.

    The session runs under dbus-run-session, whose bus has a random path,
    so it is read from the environment of the account's compositor.
    """
    for pid in os.listdir(proc):
        if not pid.isdigit():
            continue
        try:
            if os.stat(os.path.join(proc, pid)).st_uid != uid:
                continue
            with open(os.path.join(proc, pid, "comm")) as stream:
                if stream.read().strip() != "Hyprland":
                    continue
            with open(os.path.join(proc, pid, "environ"), "rb") as stream:
                variables = stream.read().split(b"\0")
        except OSError:
            continue
        for variable in variables:
            if variable.startswith(b"DBUS_SESSION_BUS_ADDRESS="):
                return variable.split(b"=", 1)[1].decode()
    return None


def notify(summary, body):
    """Show a desktop notification in the account's session, if it is up."""
    account = pwd.getpwnam(ACCOUNT)
    runtime = f"/run/user/{account.pw_uid}"
    bus = session_bus(account.pw_uid)
    if bus is None:
        return
    if os.fork() == 0:
        try:
            os.setgid(account.pw_gid)
            os.initgroups(ACCOUNT, account.pw_gid)
            os.setuid(account.pw_uid)
            os.execvpe("notify-send", ["notify-send", summary, body],
                       dict(os.environ, HOME=account.pw_dir,
                            XDG_RUNTIME_DIR=runtime,
                            DBUS_SESSION_BUS_ADDRESS=bus))
        finally:
            os._exit(1)
    os.wait()


def reconfigure_in_background():
    """Apply /etc/config.scm in a process that outlives this setup."""
    if os.fork() != 0:
        return
    try:
        os.setsid()
        if os.fork() != 0:
            os._exit(0)
        log = os.open(RECONFIGURE_LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(log, 1)
        os.dup2(log, 2)
        environment = dict(os.environ, HOME="/root",
                           PATH=os.environ.get("PATH", "") +
                           ":/run/current-system/profile/bin"
                           ":/run/current-system/profile/sbin")
        done = subprocess.run([RECONFIGURE], env=environment).returncode == 0
        if done:
            notify("Roguix settings applied",
                   "Host name, time zone and keyboard now survive a restart.")
        else:
            notify("Roguix settings not applied",
                   f"They last until a restart; see {RECONFIGURE_LOG}.")
    finally:
        os._exit(0)


def main():
    settings = host_settings()
    print("\nRoguix: first start\n")
    layout = ask_layout(suggested_layout(settings))
    apply_layout(layout)
    password = ask_password()
    while True:
        name = gum("input", "--header", "Your name for Git commits (optional)")
        email = gum("input", "--header", "Your email for Git commits (optional)")
        host_name = ask_host_name()
        timezone = ask_timezone(suggested_timezone(settings))
        print(f"\nKeyboard:  {layout[0]}\nHost name: {host_name}\n"
              f"Time zone: {timezone}\nGit:       {name or '-'} <{email or '-'}>\n")
        if subprocess.run([GUM, "confirm", "Save these settings?"]).returncode == 0:
            break
    set_git_identity(name, email)
    # The password last: until it is set, first boot runs this setup again.
    text = open(CONFIG, encoding="utf-8").read()
    replace_file(CONFIG, with_setup(text, setup_block(host_name, timezone,
                                                      layout[1], layout[2])))
    apply_system(host_name, timezone)
    set_password(password)
    reconfigure_in_background()
    print(f"Saved in {CONFIG}. Starting the desktop; the system applies the\n"
          "settings in the background and says when they survive a restart.\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except Failure as error:
        print(f"roguix-setup: {error}", file=sys.stderr)
        sys.exit(1)
