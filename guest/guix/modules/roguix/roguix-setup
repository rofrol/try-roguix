#!/usr/bin/env python3
"""roguix-setup: Roguix's first-start setup on tty1, run as root.

It asks in Omarchy's order (install/provisioning/setup-form.sh): keyboard
layout, the password of the account, an optional Git name and email, the host
name and the time zone. The Mac app suggests the keyboard layout and time zone
through the launcher's settings (/run/roguix/host-settings).

System values go into /var/lib/roguix/machine-settings.scm, a data file
that /etc/config.scm reads, and take effect at once; until a reconfigure
builds them into the system, the roguix-machine-settings service applies
them at every boot, so the setup starts no reconfigure. The Git identity
goes into the account's ~/.gitconfig.

One process reads the terminal for every question, in raw mode set once
and never flushed, so keys typed ahead of the next question are kept: with
a separate gum process per question they were lost between questions. Each
question announces itself on the serial console (/dev/hvc0, captured by the
Mac app) as "roguix-setup: ready STEP", which end-to-end tests wait for.
"""

import base64
import os
import pwd
import re
import select
import signal
import socket
import subprocess
import sys
import termios

ACCOUNT = "guest"
MACHINE_SETTINGS = "/var/lib/roguix/machine-settings.scm"
HOST_SETTINGS = "/run/roguix/host-settings"


def system_zoneinfo():
    """The zoneinfo directory of the running system's tzdata.

    Guix keeps tzdata out of the system profile: TZDIR names it in login
    shells, and /run/current-system/etc/localtime links into it otherwise.
    """
    tzdir = os.environ.get("TZDIR", "")
    if os.path.isdir(tzdir):
        return tzdir
    target = os.path.realpath("/run/current-system/etc/localtime")
    marker = "/share/zoneinfo/"
    if marker in target:
        return target[:target.index(marker) + len(marker) - 1]
    return "/usr/share/zoneinfo"


ZONEINFO = system_zoneinfo()
EVENTS = "/dev/hvc0"

# (label, XKB layout, XKB variant, console keymap). XKB drives Guix's
# keyboard-layout and Hyprland (through /etc/vconsole.conf); the console
# keymap is only for loadkeys during this boot.
