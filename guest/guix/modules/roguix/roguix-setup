    ("Belgian", "be", "", "be-latin1"),
    ("Brazilian", "br", "", "br-abnt2"),
    ("Croatian", "hr", "", "croat"),
    ("Czech", "cz", "", "cz"),
    ("Danish", "dk", "", "dk-latin1"),
    ("Dutch", "nl", "", "nl"),
    ("Estonian", "ee", "", "et"),
    ("Finnish", "fi", "", "fi"),
    ("French", "fr", "", "fr"),
    ("French (Canada)", "ca", "", "cf"),
    ("French (Switzerland)", "ch", "fr", "fr_CH"),
